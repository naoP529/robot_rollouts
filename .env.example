# OpenAI SDK経由でcap/のコード生成LLMを呼ぶ。デフォルトはGeminiだが、LLM_BASE_URLと
# LLM_MODEL_NAMEをOpenAI互換の別エンドポイントに向ければ他プロバイダにも切り替えられる。
LLM_API_KEY=

# 省略時は https://generativelanguage.googleapis.com/v1beta/openai/ (Gemini) を使う。
# 例: OpenAI本家に向ける場合は https://api.openai.com/v1
# LLM_BASE_URL=

# 省略時は gemini-4-argon を使う。
# LLM_MODEL_NAME=
